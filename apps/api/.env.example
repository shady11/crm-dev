# --- Required in every environment. The API refuses to start without these. ---

DATABASE_URL="postgresql://postgres:password@localhost:5432/crm_dev"

# Signs access tokens. Generate a long random value per environment; changing it
# invalidates every issued token.
JWT_SECRET="change_me"

# Every origin the web app is served from, comma-separated. Used for both the
# REST API and the notifications WebSocket — they must agree, so there is only
# one variable. No trailing slash.
#   e.g. FRONTEND_URL="https://crm.example.kg,http://192.168.1.10"
FRONTEND_URL="http://localhost:5173"

# --- Required in production (NODE_ENV=production) ---

# Absolute path to a persistent volume for uploaded documents. Defaults to
# ./uploads/documents in development; in a container that default is destroyed
# by the next redeploy, so a real path is mandatory on a server.
# UPLOADS_DIR="/var/lib/crm/uploads"

# --- Optional ---

# Serves an interactive API reference at /api/docs. Leave off in production.
# ENABLE_API_DOCS="true"

JWT_EXPIRES_IN="7d"
PORT=3000

# How long a SUPER_ADMIN's session stays valid, regardless of the JWT's own
# 7-day expiry — compromise of one SUPER_ADMIN account compromises every
# tenant, so it is held to a shorter bar. Default 60 if unset.
# SUPER_ADMIN_SESSION_MAX_AGE_MINUTES=60

# How long a "view as this user" impersonation session lasts before it must
# be started again. Default 30 if unset.
# IMPERSONATION_SESSION_MINUTES=30

# --- Outbound email (payment reminders, notifications) ---
# Leave SMTP_HOST unset to keep reminders logging-only (local dev, tests).
# Once set, EMAIL-channel reminders send for real; SMS still logs until a
# gateway is chosen for that channel.
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="apikey"
# SMTP_PASSWORD="change_me"
# SMTP_FROM="CRM Dev <no-reply@crm.example.kg>"

# --- Outbound WhatsApp (payment reminders) ---
# WhatsApp Business Platform via Meta's Cloud API. Requires a WhatsApp
# Business Account and a verified phone number set up in Meta Business
# Manager (business.facebook.com) first — this cannot be automated. Once set,
# WHATSAPP-channel reminders send for real, using the Meta-approved templates
# listed in whatsapp-template-map.ts (each must be submitted and approved in
# Meta Business Manager before its reminder stage will actually deliver).
# WHATSAPP_ACCESS_TOKEN="change_me"
# WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# Graph API version to call. Default v21.0 if unset.
# WHATSAPP_API_VERSION="v21.0"
# Language code your approved templates were submitted in. Default en_US if unset.
# WHATSAPP_TEMPLATE_LANGUAGE="en_US"

# --- Account lockout ---
# Failed logins before an account is temporarily locked. Default 5 if unset.
# LOGIN_LOCKOUT_THRESHOLD=5
# Lockout duration in minutes. Default 15 if unset.
# LOGIN_LOCKOUT_MINUTES=15

# --- Document storage ---
# "local" (default) writes uploads to UPLOADS_DIR on this server's disk —
# fine for a single-instance pilot, but files do not survive a redeploy or
# a second instance. "s3" writes to an S3-compatible bucket instead.
# STORAGE_DRIVER="local"
# AWS_S3_BUCKET="crm-dev-documents"
# AWS_REGION="eu-central-1"
# AWS_ACCESS_KEY_ID="change_me"
# AWS_SECRET_ACCESS_KEY="change_me"
# Only needed for non-AWS S3-compatible providers (e.g. MinIO, DigitalOcean Spaces).
# AWS_S3_ENDPOINT="https://fra1.digitaloceanspaces.com"
