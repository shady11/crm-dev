# --- Required in every environment. The API refuses to start without these. ---

DATABASE_URL="postgresql://postgres:password@localhost:5432/crm_dev"

# Signs access tokens. Generate a long random value per environment; changing it
# invalidates every issued token.
JWT_SECRET="change_me"

# Every origin the web app is served from, comma-separated. Used for both the
# REST API and the notifications WebSocket — they must agree, so there is only
# one variable. No trailing slash.
#   e.g. FRONTEND_URL="https://crm.example.kg,http://192.168.1.10"
FRONTEND_URL="http://localhost:5173"

# --- Required in production (NODE_ENV=production) ---

# Absolute path to a persistent volume for uploaded documents. Defaults to
# ./uploads/documents in development; in a container that default is destroyed
# by the next redeploy, so a real path is mandatory on a server.
# UPLOADS_DIR="/var/lib/crm/uploads"

# --- Optional ---

# Serves an interactive API reference at /api/docs. Leave off in production.
# ENABLE_API_DOCS="true"

JWT_EXPIRES_IN="7d"
PORT=3000

# How long a SUPER_ADMIN's session stays valid, regardless of the JWT's own
# 7-day expiry — compromise of one SUPER_ADMIN account compromises every
# tenant, so it is held to a shorter bar. Default 60 if unset.
# SUPER_ADMIN_SESSION_MAX_AGE_MINUTES=60

# How long a "view as this user" impersonation session lasts before it must
# be started again. Default 30 if unset.
# IMPERSONATION_SESSION_MINUTES=30
