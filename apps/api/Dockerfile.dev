# Development image for the API. Source is bind-mounted by docker-compose.yml;
# this image only provides Node, dependencies and Chromium (used by Playwright
# for PDF document generation).
FROM node:22-bookworm-slim

WORKDIR /app

# openssl: required by Prisma's engines.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
# postinstall runs `prisma generate`, which only needs DATABASE_URL to be set.
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npm ci \
    && sha256sum package-lock.json | cut -d' ' -f1 > node_modules/.lock-hash \
    && npx playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

COPY docker/entrypoint.dev.sh /usr/local/bin/entrypoint.dev.sh
RUN chmod +x /usr/local/bin/entrypoint.dev.sh

EXPOSE 3000
ENTRYPOINT ["entrypoint.dev.sh"]
CMD ["npm", "run", "start:dev"]
