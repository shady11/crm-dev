generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  SALES_MANAGER
  SALES_HEAD
  FINANCE
}

enum LeadStatus {
  NEW
  CONTACTED
  MEETING_SCHEDULED
  NEGOTIATION
  BOOKING
  CONTRACT
  SOLD
  REJECTED
}

enum UnitType {
  APARTMENT
  COMMERCIAL
  PARKING
  STORAGE
}

enum UnitStatus {
  AVAILABLE
  BOOKED
  SOLD
  INSTALLMENT
  MORTGAGE
  UNAVAILABLE
}

enum DealStatus {
  BOOKED
  CONTRACT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MBANK
  OPTIMA
  ELKART
  OTHER
}

model Company {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  leads    Lead[]
  clients  Client[]
  projects Project[]
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  leads     Lead[]   @relation("LeadManager")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id       String     @id @default(uuid())
  source   String?
  status   LeadStatus @default(NEW)
  fullName String
  phone    String
  email    String?
  comment  String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  managerId String?
  manager   User?   @relation("LeadManager", fields: [managerId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, managerId])
  @@index([phone])
}

model Client {
  id       String  @id @default(uuid())
  fullName String
  phone    String
  whatsapp String?
  email    String?
  passport String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  leads Lead[]
  deals Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, phone])
}

model Project {
  id      String  @id @default(uuid())
  name    String
  address String?
  status  String  @default("active")

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  blocks Block[]
  units  Unit[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  entrances Entrance[]
  floors    Floor[]

  @@index([companyId])
}

model Block {
  id    String @id @default(uuid())
  name  String
  order Int    @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  entrancesCount Int @default(0)
  floorsCount    Int @default(0)
  unitsCount     Int @default(0)

  entrances Entrance[]
  floors    Floor[]
  units     Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model Entrance {
  id    String @id @default(uuid())
  name  String
  order Int    @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  blockId String
  block   Block  @relation(fields: [blockId], references: [id])

  floors Floor[]
  units  Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blockId, name])
  @@index([blockId])
  @@index([projectId])
}

model Floor {
  id     String @id @default(uuid())
  number Int
  order  Int    @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  blockId String
  block   Block  @relation(fields: [blockId], references: [id])

  entranceId String
  entrance   Entrance @relation(fields: [entranceId], references: [id])

  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entranceId, number])
  @@index([entranceId])
  @@index([blockId])
  @@index([projectId])
}

model Unit {
  id     String     @id @default(uuid())
  number String
  type   UnitType   @default(APARTMENT)
  status UnitStatus @default(AVAILABLE)

  rooms Int?
  area  Decimal
  price Decimal

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  blockId String
  block   Block  @relation(fields: [blockId], references: [id])

  entranceId String
  entrance   Entrance @relation(fields: [entranceId], references: [id])

  floorId String
  floor   Floor  @relation(fields: [floorId], references: [id])

  deals Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blockId, number])
  @@index([projectId])
  @@index([blockId])
  @@index([entranceId])
  @@index([floorId])
  @@index([status])
  @@index([type])
  @@index([blockId, status])
  @@index([blockId, type])
}

model Deal {
  id           String     @id @default(uuid())
  status       DealStatus @default(BOOKED)
  amount       Decimal
  bookingUntil DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id      String        @id @default(uuid())
  amount  Decimal
  paidAt  DateTime
  method  PaymentMethod
  comment String?

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
