generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  SALES_MANAGER
  SALES_HEAD
  FINANCE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING
  NEGOTIATION
  CONVERTED
  LOST
}

enum ProjectStatus {
  DRAFT
  PLANNING
  ACTIVE
  PAUSED
  SOLDOUT
  COMPLETED
  ARCHIVED
}

enum UnitType {
  APARTMENT
  COMMERCIAL
  PARKING
  STORAGE
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  UNAVAILABLE
}

enum DealStatus {
  RESERVED
  CONTRACT_SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MBANK
  OPTIMA
  ELKART
  OTHER
}

enum FinancingType {
  CASH
  INSTALLMENT
  MORTGAGE
}

enum PaymentType {
  DEPOSIT
  INSTALLMENT
  FINAL
  REFUND
}

enum PaymentScheduleStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED

  CLIENT_CREATED
  CLIENT_UPDATED

  DEAL_CREATED
  DEAL_UPDATED

  UNIT_RESERVED
  RESERVATION_EXTENDED
  RESERVATION_CANCELLED

  CONTRACT_SIGNED

  PAYMENT_RECEIVED
  PAYMENT_REFUNDED

  NOTE_ADDED

  TASK_CREATED
  TASK_COMPLETED

  CALL
  MEETING
  EMAIL
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED

  RESERVED_UNIT
  CANCELLED_RESERVATION

  CREATED_DEAL
  UPDATED_DEAL
  CHANGED_DEAL_STATUS

  CREATED_PAYMENT
  RECEIVED_PAYMENT

  GENERATED_CONTRACT

  CREATED_TASK
  COMPLETED_TASK

  NOTE_ADDED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DocumentOwnerType {
  LEAD
  CLIENT
  DEAL
  PROJECT
  UNIT
}

enum DocumentType {
  PASSPORT
  CONTRACT
  RESERVATION
  PAYMENT_RECEIPT
  PAYMENT_SCHEDULE
  INVOICE
  AGREEMENT
  POWER_OF_ATTORNEY
  FLOOR_PLAN
  OTHER
}

model Company {
  id String @id @default(uuid())

  name    String
  phone   String?
  address String?

  currency String? @default("KGS")
  timezone String?
  locale   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users      User[]
  leads      Lead[]
  clients    Client[]
  projects   Project[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  documents  Document[]
}

model User {
  id String @id @default(uuid())

  fullName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  leads         Lead[]
  managedLeads  Lead[]     @relation("LeadManager")
  deals         Deal[]
  reservedDeals Deal[]     @relation("ReservedBy")
  payments      Payment[]
  activities    Activity[]
  tasks         Task[]
  documents     Document[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Lead {
  id String @id @default(uuid())

  source   String?
  status   LeadStatus @default(NEW)
  fullName String
  phone    String
  email    String?
  comment  String?

  nextContactAt DateTime?
  lastContactAt DateTime?
  assignedAt    DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  managerId String?
  manager   User?   @relation("LeadManager", fields: [managerId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  activities Activity[]
  tasks      Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, managerId])
  @@index([phone])
}

model Client {
  id String @id @default(uuid())

  fullName  String
  phone     String
  whatsapp  String?
  email     String?
  passport  String?
  pin       String?
  birthDate DateTime?
  address   String?
  notes     String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  leads      Lead[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyId, phone])
}

model Project {
  id String @id @default(uuid())

  name    String
  address String?
  status  ProjectStatus @default(DRAFT)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  blocks    Block[]
  units     Unit[]
  entrances Entrance[]
  floors    Floor[]
  deals     Deal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
}

model Block {
  id String @id @default(uuid())

  name  String
  order Int    @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  entrancesCount Int @default(0)
  floorsCount    Int @default(0)
  unitsCount     Int @default(0)

  entrances Entrance[]
  floors    Floor[]
  units     Unit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([projectId, name])
  @@index([projectId])
}

model Entrance {
  id String @id @default(uuid())

  name  String
  order Int    @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  blockId String
  block   Block  @relation(fields: [blockId], references: [id])

  floors Floor[]
  units  Unit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([blockId, name])
  @@index([blockId])
  @@index([projectId])
}

model Floor {
  id String @id @default(uuid())

  number Int
  order  Int @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  blockId String
  block   Block  @relation(fields: [blockId], references: [id])

  entranceId String
  entrance   Entrance @relation(fields: [entranceId], references: [id])

  units Unit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([entranceId, number])
  @@index([entranceId])
  @@index([blockId])
  @@index([projectId])
}

model Unit {
  id String @id @default(uuid())

  number String
  type   UnitType   @default(APARTMENT)
  status UnitStatus @default(AVAILABLE)

  rooms       Int?
  area        Decimal
  price       Decimal
  pricePerSqm Decimal?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  blockId String
  block   Block  @relation(fields: [blockId], references: [id])

  entranceId String
  entrance   Entrance @relation(fields: [entranceId], references: [id])

  floorId String
  floor   Floor  @relation(fields: [floorId], references: [id])

  deals Deal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([blockId, number])
  @@index([projectId])
  @@index([blockId])
  @@index([entranceId])
  @@index([floorId])
  @@index([status])
  @@index([type])
  @@index([blockId, status])
  @@index([blockId, type])
}

model Deal {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  managerId String?
  manager   User?   @relation(fields: [managerId], references: [id])

  dealNumber    String
  status        DealStatus     @default(RESERVED)
  financingType FinancingType?

  listPrice Decimal @db.Decimal(14, 2)
  salePrice Decimal @db.Decimal(14, 2)

  discountAmount  Decimal? @db.Decimal(14, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  deposit         Decimal? @db.Decimal(14, 2)

  reservedAt           DateTime?
  reservationExpiresAt DateTime?
  reservedById         String?
  reservedBy           User?     @relation("ReservedBy", fields: [reservedById], references: [id])

  contractNumber String?
  contractDate   DateTime?

  cancelledAt  DateTime?
  cancelReason String?

  note String? @db.Text

  paymentSchedules PaymentSchedule[]
  payments         Payment[]

  activities Activity[]
  tasks      Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, dealNumber])
  @@index([projectId])
  @@index([unitId])
  @@index([clientId])
  @@index([managerId])
  @@index([status])
  @@index([companyId, status])
  @@index([companyId, managerId])
  @@index([companyId, clientId])
  @@index([companyId, createdAt])
}

model Payment {
  id String @id @default(uuid())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  amount Decimal @db.Decimal(14, 2)

  paymentMethod PaymentMethod
  paymentType   PaymentType

  paidAt DateTime

  reference String?

  note String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([dealId])
  @@index([paidAt])
  @@index([paymentMethod])
  @@index([paymentType])
}

model PaymentSchedule {
  id String @id @default(uuid())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  dueDate DateTime

  amount Decimal @db.Decimal(14, 2)

  paidAmount Decimal @default(0) @db.Decimal(14, 2)

  status PaymentScheduleStatus
  order  Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([dealId, order])
  @@index([dealId])
  @@index([status])
  @@index([dueDate])
  @@index([dealId, dueDate])
}

model Activity {
  id String @id @default(uuid())

  action ActivityAction

  type ActivityType

  title       String
  description String?
  metadata    Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([dealId])
  @@index([clientId])
  @@index([leadId])
}

model Task {
  id String @id @default(uuid())

  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(TODO)

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@index([dealId])
  @@index([clientId])
  @@index([leadId])
}

model Document {
  id String @id @default(uuid())

  name         String
  originalName String
  mimeType     String
  extension    String

  size Int

  path String
  url  String?

  type DocumentType @default(OTHER)

  ownerType DocumentOwnerType
  ownerId   String

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  metadata Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([ownerType, ownerId])
  @@index([type])
  @@index([uploadedById])
  @@index([createdAt])
}
