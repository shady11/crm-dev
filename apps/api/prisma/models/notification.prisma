enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  DEAL_STATUS_CHANGED
  RESERVATION_EXPIRING
  PAYMENT_RECEIVED
  DOCUMENT_UPLOADED
  PAYMENT_DUE_SOON
  PAYMENT_OVERDUE
}

enum NotificationEntityType {
  TASK
  DEAL
  CLIENT
  DOCUMENT
  PAYMENT_SCHEDULE
}

model Notification {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type    NotificationType
  title   String
  message String?

  entityType NotificationEntityType?
  entityId   String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId, isRead])
  @@index([createdAt])
}
