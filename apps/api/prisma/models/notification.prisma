enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_ESCALATED
  DEAL_STATUS_CHANGED
  RESERVATION_EXPIRING
  PAYMENT_RECEIVED
  DOCUMENT_UPLOADED
  PAYMENT_DUE_SOON
  PAYMENT_OVERDUE
  DISCOUNT_APPROVAL_REQUESTED
  DISCOUNT_DECIDED
}

enum NotificationEntityType {
  TASK
  DEAL
  CLIENT
  DOCUMENT
  PAYMENT_SCHEDULE
}

model Notification {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type    NotificationType
  // English text, kept as written: what older clients and rows without a
  // template show.
  title   String
  message String?
  // What the web app renders, in the reader's language: a key into its
  // "notifications:templates" translations and the raw values to fill in
  // (deal number, status code, amount and currency, ISO date).
  templateKey String?
  params      Json?

  entityType NotificationEntityType?
  entityId   String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId, isRead])
  @@index([createdAt])
}
