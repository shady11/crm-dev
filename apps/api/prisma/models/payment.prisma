enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MBANK
  OPTIMA
  ELKART
  OTHER
}

enum PaymentType {
  DEPOSIT
  INSTALLMENT
  FINAL
  REFUND
}

enum PaymentScheduleStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

model Payment {
  id String @id @default(uuid())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  amount Decimal @db.Decimal(14, 2)

  paymentMethod PaymentMethod
  paymentType   PaymentType

  paidAt DateTime

  reference String?

  note String?

  // FIN-8: R-YYYY-NNNN, from ReceiptNumberCounter when the payment is
  // recorded. Every incoming payment gets one, gap-free per company and
  // year; a refund doesn't, since it isn't a receipt.
  receiptNumber String?

  // The receipt PDF, once someone has asked for it. Generated on request
  // and reused after that, so the same number always prints the same file.
  receiptDocumentId String?   @unique
  receiptDocument   Document? @relation(fields: [receiptDocumentId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([dealId])
  @@index([receiptNumber])
  @@index([paidAt])
  @@index([paymentMethod])
  @@index([paymentType])
}

model PaymentSchedule {
  id String @id @default(uuid())

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  dueDate DateTime

  amount Decimal @db.Decimal(14, 2)

  paidAmount Decimal @default(0) @db.Decimal(14, 2)

  status PaymentScheduleStatus
  order  Int

  outboundMessages OutboundMessage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([dealId, order])
  @@index([dealId])
  @@index([status])
  @@index([dueDate])
  @@index([dealId, dueDate])
}

// Hands out receipt numbers the way DealNumberCounter hands out deal numbers:
// one row per company and year, incremented under a row lock.
model ReceiptNumberCounter {
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  year         Int
  lastSequence Int @default(0)

  @@id([companyId, year])
}
