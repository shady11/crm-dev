enum DocumentOwnerType {
  LEAD
  CLIENT
  DEAL
  PROJECT
  UNIT
}

enum DocumentType {
  PASSPORT
  CONTRACT
  RESERVATION
  PAYMENT_RECEIPT
  PAYMENT_SCHEDULE
  INVOICE
  AGREEMENT
  POWER_OF_ATTORNEY
  FLOOR_PLAN
  OTHER
}

model Document {
  id String @id @default(uuid())

  name         String
  originalName String
  mimeType     String
  extension    String

  size Int

  path String
  url  String?

  type DocumentType @default(OTHER)

  ownerType DocumentOwnerType
  ownerId   String

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  metadata Json?

  // Set only for a system-generated file (see DocumentGenerationService);
  // null for anything a user uploaded through the ordinary upload endpoint.
  // This is what distinguishes "generated" from "uploaded" without a
  // separate table, and traces a generated file back to the template
  // version that produced it.
  generatedFromTemplateId String?
  generatedFromTemplate   DocumentTemplate? @relation(fields: [generatedFromTemplateId], references: [id])

  activities Activity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Set once DocumentsCleanupService has removed the underlying file from
  // storage (local disk or S3) after deletedAt has aged past the retention
  // window — see DOCUMENT_RETENTION_DAYS. The row itself is kept for audit
  // history; only the bytes are gone. Null means the file (if any —
  // deletedAt null too) is still present in storage.
  purgedAt DateTime?

  @@index([companyId])
  @@index([ownerType, ownerId])
  @@index([type])
  @@index([uploadedById])
  @@index([createdAt])
  @@index([generatedFromTemplateId])
  @@index([deletedAt, purgedAt])
}
