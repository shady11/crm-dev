// Inventory (Project/Block/Entrance/Floor/Unit) is deliberately NOT scoped to
// a Branch. Decision: any branch can see and reserve any unit — the existing
// atomic unit-booking logic stays company-scoped, untouched by branch
// isolation. This is a decision, not an oversight; revisit only if real usage
// shows branches stepping on each other's inventory.
enum ProjectStatus {
  DRAFT
  PLANNING
  ACTIVE
  PAUSED
  SOLDOUT
  COMPLETED
  ARCHIVED
}

model Project {
  id String @id @default(uuid())

  name    String
  address String?
  status  ProjectStatus @default(DRAFT)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  blocks    Block[]
  units     Unit[]
  entrances Entrance[]
  floors    Floor[]
  deals     Deal[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
}
