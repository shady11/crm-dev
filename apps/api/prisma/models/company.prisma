model Company {
  id String @id @default(uuid())

  name    String
  phone   String?
  address String?

  currency String? @default("KGS")
  timezone String?
  locale   String?

  // Legal identity used on generated contracts/agreements — distinct from
  // the trading `name` above, which is what the CRM shows in menus and
  // headers. Nullable because a tenant can use the CRM fully before ever
  // generating a document; DocumentGenerationService is what actually
  // requires these to be filled in.
  legalName      String?
  taxId          String?
  signatoryName  String?
  signatoryTitle String?
  letterheadUrl  String?

  // Discretionary discount ceilings, in percent — a SALES_MANAGER/SALES_HEAD
  // request at or below their own limit auto-applies; above it, it needs
  // sign-off from the next band up. See DealDomainService.requiresDiscountApproval.
  // Defaulted rather than nullable so a company that never configures this
  // still has a real gate, not an accidental "everything auto-approves."
  salesManagerDiscountLimit Decimal @default(5) @db.Decimal(5, 2)
  salesHeadDiscountLimit    Decimal @default(15) @db.Decimal(5, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Suspension is reversible and deletion is not. Kept as two fields rather
  // than one status enum so "suspended on <date>" and "deleted on <date>" are
  // both answerable, which matters when a tenant disputes a billing gap.
  suspendedAt DateTime?
  deletedAt   DateTime?

  users      User[]
  branches   Branch[]
  leads      Lead[]
  clients    Client[]
  projects   Project[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  documents  Document[]
  documentTemplates DocumentTemplate[]
  outboundMessages  OutboundMessage[]

  notifications      Notification[]
  dealNumberCounters DealNumberCounter[]

  auditLogs AuditLog[]

  impersonationSessions ImpersonationSession[]
}
