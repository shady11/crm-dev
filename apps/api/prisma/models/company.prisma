model Company {
  id String @id @default(uuid())

  name    String
  phone   String?
  address String?

  currency String? @default("KGS")
  timezone String?
  locale   String?

  // Legal identity used on generated contracts/agreements — distinct from
  // the trading `name` above, which is what the CRM shows in menus and
  // headers. Nullable because a tenant can use the CRM fully before ever
  // generating a document; DocumentGenerationService is what actually
  // requires these to be filled in.
  legalName      String?
  taxId          String?
  signatoryName  String?
  signatoryTitle String?
  letterheadUrl  String?

  // Reservation policy — see DealDomainService.resolveReservationExpiry /
  // ensureCanExtendReservation. A booking made without an expiry date holds
  // the unit for reservationDefaultDays; any expiry set at booking or on
  // extension may be at most reservationMaxDays from that moment; a
  // reservation may be extended at most reservationMaxExtensions times.
  reservationDefaultDays   Int @default(7)
  reservationMaxDays       Int @default(14)
  reservationMaxExtensions Int @default(2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Suspension is reversible and deletion is not. Kept as two fields rather
  // than one status enum so "suspended on <date>" and "deleted on <date>" are
  // both answerable, which matters when a tenant disputes a billing gap.
  suspendedAt DateTime?
  deletedAt   DateTime?

  users      User[]
  branches   Branch[]
  leads      Lead[]
  clients    Client[]
  projects   Project[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  documents  Document[]
  documentTemplates DocumentTemplate[]
  outboundMessages  OutboundMessage[]

  notifications      Notification[]
  dealNumberCounters DealNumberCounter[]

  auditLogs AuditLog[]

  impersonationSessions ImpersonationSession[]

  // Custom roles this tenant defined for itself (companyId != null). System
  // roles (companyId == null) are not related to any one Company.
  roles Role[]
}
