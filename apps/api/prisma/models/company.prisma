model Company {
  id String @id @default(uuid())

  name    String
  phone   String?
  address String?

  currency String? @default("KGS")
  timezone String?
  locale   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Suspension is reversible and deletion is not. Kept as two fields rather
  // than one status enum so "suspended on <date>" and "deleted on <date>" are
  // both answerable, which matters when a tenant disputes a billing gap.
  suspendedAt DateTime?
  deletedAt   DateTime?

  users      User[]
  leads      Lead[]
  clients    Client[]
  projects   Project[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
  documents  Document[]

  notifications      Notification[]
  dealNumberCounters DealNumberCounter[]
}
