model Activity {
  id String @id @default(uuid())

  action ActivityAction

  type ActivityType

  title       String
  description String?
  metadata    Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])

  blockId String?
  block   Block?  @relation(fields: [blockId], references: [id])

  entranceId String?
  entrance   Entrance? @relation(fields: [entranceId], references: [id])

  floorId String?
  floor   Floor?  @relation(fields: [floorId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  // The Branch entity itself, for BRANCH_* activity types — unrelated to how
  // findAll() scopes the feed by the *actor's* branchId (see
  // ActivitiesService's doc comment).
  targetBranchId String?
  targetBranch   Branch? @relation(fields: [targetBranchId], references: [id])

  // The user acted upon, for USER_* activity types (e.g. the user created,
  // deactivated, or transferred) — distinct from userId, which is always the
  // actor. Null for every other activity type.
  targetUserId String?
  targetUser   User?   @relation("ActivityTargetUser", fields: [targetUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([dealId])
  @@index([clientId])
  @@index([leadId])
  @@index([targetUserId])
  @@index([unitId])
  @@index([projectId])
  @@index([targetBranchId])
  @@index([taskId])
  @@index([documentId])
  @@index([blockId])
  @@index([entranceId])
  @@index([floorId])
}
