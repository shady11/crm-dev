  LEAD_UPDATED

  CLIENT_CREATED
  CLIENT_UPDATED

  DEAL_CREATED
  DEAL_UPDATED

  UNIT_RESERVED
  RESERVATION_EXTENDED
  RESERVATION_CANCELLED
  RESERVATION_EXPIRED

  CONTRACT_SIGNED
  DOCUMENT_GENERATED

  DISCOUNT_REQUESTED
  DISCOUNT_APPROVED
  DISCOUNT_REJECTED

  PAYMENT_RECEIVED
  PAYMENT_REFUNDED

  NOTE_ADDED

  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_STATUS_CHANGED
  TASK_REASSIGNED
  TASK_DELETED

  CALL
  MEETING
  EMAIL
  MESSAGE_SENT

  LEAD_BRANCH_TRANSFERRED
  CLIENT_BRANCH_TRANSFERRED

  LEAD_REASSIGNED
  DEAL_REASSIGNED

  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_BRANCH_TRANSFERRED
  USER_DEACTIVATED
  USER_PASSWORD_RESET
  USER_SESSIONS_REVOKED

  UNIT_CREATED
  UNIT_UPDATED
  UNIT_STATUS_CHANGED
  UNIT_DELETED
  UNITS_IMPORTED

