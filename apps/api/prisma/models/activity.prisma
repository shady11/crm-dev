  CREATED_PAYMENT
  RECEIVED_PAYMENT

  GENERATED_CONTRACT
  GENERATED_DOCUMENT

  DISCOUNT_REQUESTED
  DISCOUNT_APPROVED
  DISCOUNT_REJECTED

  CREATED_TASK
  UPDATED_TASK
  COMPLETED_TASK
  CHANGED_TASK_STATUS

  NOTE_ADDED

  BRANCH_TRANSFERRED
  REASSIGNED

  LOGGED_CONTACT_ATTEMPT

  CREATED_USER
  UPDATED_USER
  ROLE_CHANGED
  DEACTIVATED_USER
  RESET_PASSWORD
  REVOKED_SESSIONS

  CREATED_UNIT
  UPDATED_UNIT
  CHANGED_UNIT_STATUS
  DELETED_UNIT
  IMPORTED_UNITS

  CREATED_PROJECT
  UPDATED_PROJECT
  CHANGED_PROJECT_STATUS
  DELETED_PROJECT

  CREATED_BRANCH
  UPDATED_BRANCH
  DEACTIVATED_BRANCH
  REACTIVATED_BRANCH

  DELETED_TASK

  UPLOADED_DOCUMENT
  DELETED_DOCUMENT
  UPDATED_DOCUMENT_TEMPLATE

  CREATED_BLOCK
  UPDATED_BLOCK
  DELETED_BLOCK

  CREATED_ENTRANCE
  UPDATED_ENTRANCE
  DELETED_ENTRANCE

  CREATED_FLOOR
  UPDATED_FLOOR
  DELETED_FLOOR
  IMPORTED_FLOORS

  CONVERTED_LEAD

  REACTIVATED_USER
  CHANGED_PASSWORD
