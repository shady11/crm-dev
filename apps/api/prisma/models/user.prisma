model User {
  id String @id @default(uuid())

  fullName          String
  email             String   @unique
  phone             String?
  passwordHash      String
  isActive          Boolean  @default(true)
  sessionsValidFrom DateTime @default(now())

  // The platform operator flag. Independent of the Role/permission system
  // entirely (see PermissionsGuard's unconditional bypass) rather than a
  // seeded "Super Admin" Role being special-cased by name — SUPER_ADMIN
  // belongs to no company and no Role can be meaningfully scoped to it.
  isSuperAdmin Boolean @default(false)

  // Every user has exactly one Role, dynamic rather than a fixed enum — see
  // prisma/models/rbac.prisma. RESTRICT on delete: a Role that's still
  // someone's role cannot be deleted (RbacService.deleteRole checks this
  // itself first, for a friendlier error than the FK violation).
  roleId String
  role   Role   @relation("UserPrimaryRole", fields: [roleId], references: [id], onDelete: Restrict)

  // Account lockout: incremented on each failed login, reset on success.
  // Once it reaches LOGIN_LOCKOUT_THRESHOLD, lockedUntil is set and login is
  // refused (even with the correct password) until that time passes.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // TOTP two-factor authentication. totpSecret is only ever set once the
  // user has confirmed a code against it (see AuthController's /2fa/enable);
  // totpEnabled gates whether login() requires a code at all.
  totpSecret  String?
  totpEnabled Boolean @default(false)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Required when the assigned Role is branch-scoped (Role.isBranchScoped);
  // left null for company-wide roles and SUPER_ADMIN.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  leads         Lead[]
  managedLeads  Lead[]     @relation("LeadManager")
  deals         Deal[]
  reservedDeals Deal[]     @relation("ReservedBy")
  discountApprovals Deal[] @relation("DiscountApprovedBy")
  payments      Payment[]
  activities    Activity[]
  targetOfActivities Activity[] @relation("ActivityTargetUser")
  tasks         Task[]
  documents     Document[]
  documentTemplates DocumentTemplate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  notifications Notification[]

  auditLogs AuditLog[] @relation("AuditLogActor")

  impersonationsStarted  ImpersonationSession[] @relation("ImpersonationsStarted")
  impersonationsReceived ImpersonationSession[] @relation("ImpersonationsReceived")

  @@index([companyId, branchId])
  @@index([roleId])
}
