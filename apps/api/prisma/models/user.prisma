enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  SALES_MANAGER
  SALES_HEAD
  FINANCE
}

model User {
  id String @id @default(uuid())

  fullName          String
  email             String   @unique
  phone             String?
  passwordHash      String
  role              UserRole
  isActive          Boolean  @default(true)
  sessionsValidFrom DateTime @default(now())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Required for branch-scoped roles (SALES_HEAD, SALES_MANAGER); left null
  // for company-wide roles (COMPANY_ADMIN, FINANCE) and SUPER_ADMIN.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  leads         Lead[]
  managedLeads  Lead[]     @relation("LeadManager")
  deals         Deal[]
  reservedDeals Deal[]     @relation("ReservedBy")
  discountApprovals Deal[] @relation("DiscountApprovedBy")
  payments      Payment[]
  activities    Activity[]
  tasks         Task[]
  documents     Document[]
  documentTemplates DocumentTemplate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  notifications Notification[]

  auditLogs AuditLog[] @relation("AuditLogActor")

  impersonationsStarted  ImpersonationSession[] @relation("ImpersonationsStarted")
  impersonationsReceived ImpersonationSession[] @relation("ImpersonationsReceived")

  @@index([companyId, branchId])
}