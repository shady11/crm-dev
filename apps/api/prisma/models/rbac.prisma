// Dynamic RBAC layer. Every user has exactly one Role (User.roleId, in
// user.prisma) — no fixed enum. A Permission is a fine-grained capability
// ("leads.create"), a Role is a named bundle of permissions, and effective
// permissions are simply that Role's permission set. SUPER_ADMIN is exempt
// from this check entirely (see PermissionsGuard, and User.isSuperAdmin)
// rather than needing a Role that lists every permission.
//
// A Role with companyId == null is a *system* role: seeded once, shared
// across every tenant, not renamable/deletable and its permissions fixed
// (see RbacService). A Role with companyId set is a tenant's own custom
// role, created by that tenant's COMPANY_ADMIN to slice up access more
// finely than the built-in roles allow — the actual "easily add a new
// role" path.
model Permission {
  id String @id @default(uuid())

  // Stable machine key, "<module>.<action>", e.g. "leads.create". Never
  // renamed once shipped — RolePermission rows and seed data reference it.
  key         String @unique
  module      String
  action      String
  description String

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@index([module])
}

model Role {
  id String @id @default(uuid())

  name        String
  description String?

  // Seeded, shared across all tenants, and not deletable/renamable/whose
  // permissions can't be edited. See RbacService.
  isSystem Boolean @default(false)

  // Whether a user holding this Role is isolated to one branch (their
  // User.branchId must then be set) rather than seeing company-wide data —
  // replaces the old hardcoded SALES_HEAD/SALES_MANAGER check. Drives
  // AuthUser.isBranchScoped (see SessionValidationService) and the
  // branch-required/forbidden validation in UsersService.
  isBranchScoped Boolean @default(false)

  // null = system role (global). Set = one tenant's own custom role.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  // Every user whose primary (and only) Role this is. See User.roleId.
  users User[] @relation("UserPrimaryRole")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Role names only need to be unique within the scope they're offered in:
  // a tenant's custom "Auditor" role can't collide with another custom role
  // in the same tenant, but two different tenants can each have their own.
  @@unique([companyId, name])
  @@index([companyId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}
