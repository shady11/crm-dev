enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskType {
  CALL
  MEETING
  SITE_VISIT
  FOLLOW_UP
  OTHER
}

model Task {
  id String @id @default(uuid())

  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  type        TaskType     @default(OTHER)

  // Free text for now — required by TasksService.updateStatus whenever a task
  // is closed as DONE or CANCELLED, but not modeled as an enum yet: we don't
  // know the real outcome taxonomy until reps have used it for a while.
  outcome String?

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id])

  // Derived from assignedTo's branch, not stamped from the creating user —
  // see TasksService.create.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  activities Activity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@index([dealId])
  @@index([clientId])
  @@index([leadId])
  @@index([companyId, branchId])
}
